  },
  "dependencies": {
    "css-tree": "3.2.1",
    "next": "^16.4.1",
    "parse5": "8.0.1",
    "pdf-lib": "^1.17.1",
    "pg": "^8.23.0",
    "react": "19.3.1",
    "react-dom": "19.2.8",
    "srcset": "5.0.3"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/css-tree": "3.2.0",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.1",
    "typescript": "^5",
    "vitest": "^4.1.11"
