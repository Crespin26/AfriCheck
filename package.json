{
  "name": "africheck",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "node .next/standalone/server.js",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "node scripts/migrate.mjs",
    "ci": "npm test && npm run lint && npm run build",
    "test:e2e": "playwright test",
    "prestart": "node scripts/prepare-standalone.mjs",
    "db:cleanup": "node scripts/cleanup.mjs",
    "db:backup": "node scripts/backup.mjs",
    "db:restore": "node scripts/restore.mjs",
    "test:recovery": "node scripts/test-recovery.mjs",
    "test:proxy": "node scripts/test-proxy.mjs",
